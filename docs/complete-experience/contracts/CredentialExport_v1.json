    "format": {
      "enum": ["gunnchos.credential_export.v1", "ob3_inspired", "clr_inspired"]
    },
    "credentials": { "type": "array" },
    "exported_at": { "type": "string" },
    "certification_claimed": { "type": "boolean", "const": false },
    "include_private_keys": { "const": false }
  }
}
