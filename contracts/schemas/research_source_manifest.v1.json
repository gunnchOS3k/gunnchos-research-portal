{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gunnchos.com/schemas/research_source_manifest.v1.json",
  "title": "Research source manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "title",
    "evidenceClass",
    "sourceRepo",
    "sourceSha",
    "license",
    "citation",
    "papers",
    "reports",
    "reproducibility",
    "data",
    "configs",
    "results",
    "figures",
    "limitations",
    "downloadBundle"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "SIMULATED",
        "SYNTHETIC_SIM",
        "MEASURED",
        "REFERENCE_IMPLEMENTATION",
        "LIVE_EXTERNAL_APP",
        "DOCUMENTED_ONLY"
      ]
    },
    "sourceRepo": { "type": "string", "pattern": "^gunnchOS3k/.+" },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "license": { "type": "string", "minLength": 1 },
    "citation": {
      "type": "object",
      "required": ["cff", "bibtex"],
      "properties": {
        "cff": { "type": "string", "minLength": 1 },
        "bibtex": { "type": "string", "minLength": 1 }
      }
    },
    "papers": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "reports": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "reproducibility": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "data": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "configs": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "results": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "figures": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "downloadBundle": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string" }
      }
    }
  }
}
