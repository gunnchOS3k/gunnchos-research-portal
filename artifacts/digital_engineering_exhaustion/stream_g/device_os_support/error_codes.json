      "self_serve": "offline_continue",
      "repair_tree": "RT-NETWORK"
    },
    {
      "code": "E-THERM-001",
      "severity": "high",
      "title": "Thermal throttle / shutdown",
      "self_serve": "cool_down",
      "repair_tree": "RT-THERMAL",
