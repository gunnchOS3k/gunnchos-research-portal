      "self_serve": "safe_mode",
      "repair_tree": "RT-BOOT"
    },
    {
      "code": "E-STOR-001",
      "severity": "high",
      "title": "Insufficient storage for update",
      "self_serve": "free_space",
      "repair_tree": "RT-STORAGE"
    },
    {
      "code": "E-UPD-001",
      "severity": "high",
