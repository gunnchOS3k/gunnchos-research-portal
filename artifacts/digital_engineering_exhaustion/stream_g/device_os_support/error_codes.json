    },
    {
      "code": "E-BATT-001",
      "severity": "high",
      "title": "Battery health / charge fault",
      "self_serve": "power_cycle",
      "repair_tree": "RT-BATTERY",
      "physical": true
    },
    {
      "code": "E-DISP-001",
      "severity": "high",
